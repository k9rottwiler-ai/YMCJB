# Copy to .env.local for local overrides (not committed).

# In-app unlock password (Vite build-time). Empty = no app login gate.
VITE_APP_PASSWORD=ymcjb

# Railway / Caddy HTTP basic auth (runtime — no rebuild needed to change).
# When set, browsers get a native username/password prompt before the app loads.
# APP_USERNAME=admin
# APP_PASSWORD=
